# FMB Agents — environment

# Network: "testnet" (default) or "mainnet"
NETWORK=testnet

# Privy server wallet — the agent's autonomous signer.
# Get these from the Privy dashboard (project > Wallets / App settings).
# Never commit real values; .env is gitignored.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_ID=

# Optional: override the Circle Iris API base URL.
# Defaults: testnet -> https://iris-api-sandbox.circle.com
#           mainnet -> https://iris-api.circle.com
# IRIS_BASE_URL=

# Optional RPC overrides. Defaults use public endpoints — set your own for production.
# Mainnet
# RPC_ETHEREUM_MAINNET=
# RPC_ARBITRUM_MAINNET=
# RPC_BASE_MAINNET=
# RPC_OPTIMISM_MAINNET=
# RPC_POLYGON_MAINNET=
# RPC_AVALANCHE_MAINNET=

# Testnet
# RPC_ETHEREUM_TESTNET=
# RPC_ARBITRUM_TESTNET=
# RPC_BASE_TESTNET=
# RPC_OPTIMISM_TESTNET=
# RPC_POLYGON_TESTNET=
# RPC_AVALANCHE_TESTNET=

# Telemetry — see docs/telemetry.md.
# Set TELEMETRY_ENABLED=true in production. Default false in dev/test.
# When off, the MCP runs unchanged with no telemetry overhead.
TELEMETRY_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional sampling. 1.0 = every event (default). 0.0 = no events.
# SAMPLE_RATE=1.0
# Required to authorize the Vercel Cron job that runs the daily rollup.
CRON_SECRET=
